{
  "name": "brassfern",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Brassfern — an independent digital product studio. Software with a heartbeat.",
  "scripts": {
    "predev": "node scripts/build-content-index.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-content-index.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
